rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validProduct() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 2
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 2
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.imageUrl is string
        && request.resource.data.isActive is bool;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(
          ['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string;

      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if signedIn() && (isAdmin() || resource.data.isActive == true);

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'category', 'price', 'stock',
          'imageUrl', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'description', 'category', 'price', 'stock',
          'imageUrl', 'isActive', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && validProduct()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validProduct()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'category', 'price', 'stock',
          'imageUrl', 'isActive', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
